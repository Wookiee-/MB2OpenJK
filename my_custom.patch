+void StaticHuff_PutBit( byte* fout, int bitIndex, int bit ) {
+    const int byteIndex = bitIndex >> 3;
+    const int bitOffset = bitIndex & 7;
+    if ( bitOffset == 0 ) {
+        fout[ byteIndex ] = (byte)(bit & 1);
+    } else {
+        fout[byteIndex] |= (bit & 1) << bitOffset;
+    }
+}
+
+int StaticHuff_PutSymbol( byte* fout, int offset, int symbol ) {
+    const uint16_t result = HuffmanEncoderTable[ symbol & 0xFF ];
+    const int bitCount = result & 15;
+    int code = (result >> 4) & 0x7FF;
+
+    for( int i = 0; i < bitCount; ++i ) {
+        StaticHuff_PutBit( fout, offset + i, code & 1 );
+        code >>= 1;
+    }
+    return bitCount;
+}
+
+int StaticHuff_GetBit( const byte* buffer, int bitIndex ) {
+    return (buffer[(bitIndex >> 3)] >> (bitIndex & 7)) & 0x1;
+}
+
+int StaticHuff_GetSymbol( unsigned int* symbol, const byte* buffer, int bitIndex ) {
+    // Standard Q3 bit-crunching to read the table
+    const uint16_t code = ((*(const uint32_t*)(buffer + (bitIndex >> 3))) >> (bitIndex & 7)) & 0x7FF;
+    const uint16_t entry = HuffmanDecoderTable[ code ];
+    *symbol = (unsigned int)(entry & 0xFF);
+    return (int)(entry >> 8);
+}
